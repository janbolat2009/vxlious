# Database URL (SQLite default for local development, or PostgreSQL for Supabase/Production)
DATABASE_URL="file:./dev.db"

# JWT Secret for Session & Tokens (Must be a 32+ character random string in production)
JWT_SECRET="vxlious-academic-archive-secret-key-super-secure-production-2026"

# App URL
NEXT_PUBLIC_APP_NAME="vxlious"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage Driver: "local" (default private filesystem) or "supabase"
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./data/storage"

# Optional Supabase integration for direct production deployment
